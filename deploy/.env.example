# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#
# Generate the two secrets on the host:
#   NEXTAUTH_SECRET=$(openssl rand -base64 36)
#   MEILI_MASTER_KEY=$(openssl rand -base64 36)

# Pin to a release tag (e.g. 0.x.y) for reproducible deploys, or leave "release" for latest stable.
KARAKEEP_VERSION=release

# --- secrets: replace these, do not ship the placeholders ---
NEXTAUTH_SECRET=replace_me_openssl_rand_base64_36
MEILI_MASTER_KEY=replace_me_openssl_rand_base64_36

# Public URL users reach. MUST be the https hostname or auth callbacks break.
NEXTAUTH_URL=https://karakeep.modeltok.com

# Cloudflare Tunnel: configured via deploy/cloudflared/config.yml (locally-managed, no token).
# See README step 1. No TUNNEL_TOKEN is needed for this setup.

# --- AI inference (local Ollama) ---
# The compose file already wires Karakeep to the bundled Ollama service with sane defaults.
# Override the models here only if you want different ones (must be pulled in pull-models.sh too):
# INFERENCE_TEXT_MODEL=llama3.2
# INFERENCE_IMAGE_MODEL=llava            # must be a vision-capable model
# EMBEDDING_TEXT_MODEL=nomic-embed-text

# --- video download + local transcription ---
# Downloads bookmarked videos (yt-dlp) and transcribes them (local whisper-asr sidecar,
# no external API) so spoken content feeds auto-tagging, summarization, and search.
# CRAWLER_VIDEO_DOWNLOAD=true
# CRAWLER_TRANSCRIBE_VIDEO=true
# Whisper model for the whisper-asr sidecar (tiny/base/small/medium/large-v3). Bigger = more
# accurate but slower on CPU. Changing this re-downloads the model on next `whisper-asr` start.
# TRANSCRIPTION_MODEL=base

# --- optional ---
# After creating your admin account, set to true so nobody else can register:
# DISABLE_SIGNUPS=true
